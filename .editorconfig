# Keeps every editor (Visual Studio, VS Code, Notepad++...) formatting files the same way
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cpp,h,rc}]
indent_size = 4
end_of_line = crlf

[*.{sln,vcxproj,filters,config}]
end_of_line = crlf
