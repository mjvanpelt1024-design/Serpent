  "traits": {
    "_about": "The words for each boss trait and champion ability. A boss's trait list is in bosses below; a champion's abilities are in champions. Champions' abilities (stormcall, frostbreath, venomspit, quake, swarm, phase, harden) are never given to the island bosses.",
    "charger": {
      "name": "Lance charge",
      "text": "Charges more often, and for longer."
    },
    "blink": {
      "name": "Blink",
      "text": "Vanishes and reappears a few squares from you."
    },
    "summon": {
      "name": "Summoner",
      "text": "Calls its minions onto the board."
    },
    "trail": {
      "name": "Burning trail",
      "text": "Leaves a hazard behind it as it slithers."
    },
    "enrage": {
      "name": "Enrage",
      "text": "Moves faster once it's badly hurt."
    },
    "regen": {
      "name": "Regrowth",
      "text": "Gets its breath back slowly."
    },
    "rally": {
      "name": "Last rally",
      "text": "Shrugs off the blow that would finish it, once."
    },
    "devour": {
      "name": "Devour",
      "text": "Eats apples to get its breath back."
    },
    "tide": {
      "name": "Tidecall",
      "text": "Splashes rings of frost around itself."
    },
    "stormcall": {
      "name": "Stormcall",
      "text": "Calls lightning down near your head.",
      "champion": true
    },
    "frostbreath": {
      "name": "Frost breath",
      "text": "Breathes a line of frost ahead of it.",
      "champion": true
    },
    "venomspit": {
      "name": "Venom spit",
      "text": "Spits acid at the squares in front of you.",
      "champion": true
    },
    "quake": {
      "name": "Quake",
      "text": "Shakes rocks loose all over the board.",
      "champion": true
    },
    "swarm": {
      "name": "Swarm",
      "text": "Calls a swarm of its minions at once.",
      "champion": true
    },
    "phase": {
      "name": "Phase",
      "text": "Turns to mist for a moment: you pass through, and nothing hurts it.",
      "champion": true
    },
    "harden": {
      "name": "Harden",
      "text": "Turns to stone for a few seconds: no blow lands.",
      "champion": true
    }
  },
