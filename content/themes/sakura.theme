# Theme: Sakura
name      = Sakura               # the board's own name
group     = Deluxe               # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #ffe4ec              # the main board color
painter   = sakura               # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#ffc6da, #ee76a0, #4e1a34]  # bright, middle and deep paint colors
highlight = #ff8ab0              # the accent color
particles = petals               # what drifts over the page
emblem    = flower               # its symbol in the Tailor
