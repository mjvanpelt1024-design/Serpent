# Theme: Honeycomb
name      = Honeycomb            # the board's own name
group     = Patterns             # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #2a1e08              # the main board color
lines     = #4a3510              # thin detail lines
painter   = honeycomb            # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#e0a822, #74500f, #241a06]  # bright, middle and deep paint colors
highlight = #ffd23f              # the accent color
particles = fireflies            # what drifts over the page
emblem    = hex                  # its symbol in the Tailor
