# Theme: Sunset Sky
name      = Sunset Sky           # the board's own name
group     = Gradients            # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #ff7e5f              # the main board color
accent    = #6a3093              # a second color the pattern uses
painter   = sunsetsky            # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#ff8060, #a63a80, #2e1046]  # bright, middle and deep paint colors
highlight = #ffb36b              # the accent color
particles = fireflies            # what drifts over the page
emblem    = sun                  # its symbol in the Tailor
