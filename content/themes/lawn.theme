# Theme: Lawn
name      = Lawn                 # the board's own name
group     = Patterns             # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #1e3b20              # the main board color
accent    = #25482a              # a second color the pattern uses
painter   = lawn                 # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#47a04c, #255229, #0c1c0d]  # bright, middle and deep paint colors
highlight = #8fe36f              # the accent color
particles = leaves               # what drifts over the page
emblem    = grass                # its symbol in the Tailor
