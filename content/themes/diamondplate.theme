# Theme: Diamond Plate
name      = Diamond Plate        # the board's own name
group     = Deluxe               # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #5b6470              # the main board color
accent    = #6f7a87              # a second color the pattern uses
painter   = diamondplate         # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#a2aebc, #5d6672, #1e2228]  # bright, middle and deep paint colors
highlight = #e0e6ee              # the accent color
particles = sparkle              # what drifts over the page
emblem    = diamond              # its symbol in the Tailor
