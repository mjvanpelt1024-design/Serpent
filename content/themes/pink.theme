# Theme: Pink
name      = Pink                 # the board's own name
group     = Solids               # its tier in the Tailor (themes/tiers.dat)
kind      = solid                # solid or pattern
base      = #f7a8cf              # the main board color

# The rest of the page while this theme is on
swirl     = [#ff8fc5, #c2407f, #4a1230]  # bright, middle and deep paint colors
highlight = #ff77c8              # the accent color
particles = hearts               # what drifts over the page
emblem    = heart                # its symbol in the Tailor
