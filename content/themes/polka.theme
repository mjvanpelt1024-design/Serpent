# Theme: Polka Dots
name      = Polka Dots           # the board's own name
group     = Patterns             # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #1c1233              # the main board color
lines     = #2e1f57              # thin detail lines
painter   = polka                # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#6a46c0, #2e1f60, #110a26]  # bright, middle and deep paint colors
highlight = #ff77c8              # the accent color
particles = confetti             # what drifts over the page
emblem    = dots                 # its symbol in the Tailor
