# Theme: Arcade Carpet
name      = Arcade Carpet        # the board's own name
group     = Deluxe               # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #140a24              # the main board color
painter   = arcade               # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#ff10b0, #0aa8ff, #120822]  # bright, middle and deep paint colors
highlight = #ffdd00              # the accent color
particles = confetti             # what drifts over the page
emblem    = joystick             # its symbol in the Tailor
