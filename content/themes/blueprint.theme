# Theme: Blueprint
name      = Blueprint            # the board's own name
group     = Patterns             # its tier in the Tailor (themes/tiers.dat)
kind      = pattern              # solid or pattern
base      = #0e1f3d              # the main board color
lines     = #1b3664              # thin detail lines
painter   = blueprint            # a pattern in src/art/theme-painters.js

# The rest of the page while this theme is on
swirl     = [#2f5ea6, #122950, #050d1c]  # bright, middle and deep paint colors
highlight = #8fd3ff              # the accent color
particles = sparkle              # what drifts over the page
emblem    = house                # its symbol in the Tailor
