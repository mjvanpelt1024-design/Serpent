name        = Golden Heart
description = A gold heart on top of your others. It soaks up one hit and is gone for good, and unused ones come back. Rare loyalty.
island      = easy                 # grows on this island's tree
boost       = false                # true = used up when a run starts

# Its fruit in the Satchel
fruit       = lemon                # apple, pear, orange, plum, lemon or berry
color       = #fff1b8
icon        = heart-gold
