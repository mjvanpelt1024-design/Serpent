# ==================================================================
#  Lucid Dreaming  (lucid)
#  The Great Tree, dream
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Lucid Dreaming
description = Nightmares start you with extra half hearts. Knowing you are dreaming helps, a little.
part        = dream                # trunk, bough, branch or dream
requires    = nightmare            # all = every island; nightmare = the dream roots
position    = [148, 168]           # where it hangs on the tree picture
color       = #ff5d8f
icon        = eye                  # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 0.5                  # tier 1
step        = 0.5                  # added every tier
tiers       = 5
format      = +{v} {v|heart|hearts}  # how a value is shown; {v} is the value
