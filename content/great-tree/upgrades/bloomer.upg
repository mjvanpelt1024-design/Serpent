# ==================================================================
#  Late Bloomer  (bloomer)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Late Bloomer
description = XP orbs show up more often the longer a run lasts. Patience is rewarded here, which is rare, and should be treasured.
part        = branch               # trunk, bough, branch or dream
growsFrom   = time                 # grows once this reaches the gate tier
position    = [56, 30]             # where it hangs on the tree picture
icon        = flower               # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 2                    # tier 1
step        = 2                    # added every tier
tiers       = 20
format      = +{v}% orbs per minute  # how a value is shown; {v} is the value
