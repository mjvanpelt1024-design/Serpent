# ==================================================================
#  Scale Armor  (scalearmor)
#  The Great Tree, branch (special, build 46)
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Scale Armor
description = Start every run with armor plates, from the Hive onward. A snake is mostly armor already; this is the rest.
part        = branch               # trunk, bough, branch or dream
group       = special              # priced as a special part ([great] special in economy.txt)
growsFrom   = hearts               # grows once this reaches the gate tier
position    = [68, 52]             # where it hangs on the tree picture
icon        = shield               # a picture in textures/icons/ (textures/index.json)
badge       = plus

# What each tier is worth
base        = 0
start       = 1
step        = 1
tiers       = 3
format      = +{v} {v|plate|plates}
