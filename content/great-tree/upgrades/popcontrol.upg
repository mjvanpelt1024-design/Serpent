# ==================================================================
#  Popsicle Control  (popcontrol)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Popsicle Control
description = Fewer popsicles show up, in every mode. Fewer threats, though never none.
part        = branch               # trunk, bough, branch or dream
growsFrom   = hearts               # grows once this reaches the gate tier
requires    = all                  # all = every island; nightmare = the dream roots
position    = [94, 28]             # where it hangs on the tree picture
icon        = popsicle             # a picture from src/engine/render/pixel-icons.js
badge       = x                    # corner mark: up, plus, x or star

# What each tier is worth
base        = 0                    # before the first tier
start       = 2.5                  # tier 1
step        = 2.5                  # added every tier
tiers       = 20
format      = {v}% fewer           # how a value is shown; {v} is the value
