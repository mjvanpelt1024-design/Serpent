# ==================================================================
#  Iron Stomach  (ironstomach)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Iron Stomach
description = A chance a popsicle hit does no damage at all, in every mode. An iron stomach is heavy to carry, but worth it.
part        = branch               # trunk, bough, branch or dream
growsFrom   = hearts               # grows once this reaches the gate tier
requires    = all                  # all = every island; nightmare = the dream roots
position    = [120, 16]            # where it hangs on the tree picture
icon        = anvil                # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 1.5                  # tier 1
step        = 1.5                  # added every tier
tiers       = 20
format      = {v}%                 # how a value is shown; {v} is the value
