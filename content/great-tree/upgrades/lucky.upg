# ==================================================================
#  Lucky Charms  (lucky)
#  The Great Tree, branch (special, build 46)
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Lucky Charms
description = Power-ups turn up more often, everywhere they can.
part        = branch               # trunk, bough, branch or dream
group       = special              # priced as a special part ([great] special in economy.txt)
growsFrom   = hearts               # grows once this reaches the gate tier
position    = [90, 52]             # where it hangs on the tree picture
icon        = clover               # a picture from src/engine/render/pixel-icons.js
badge       = plus

# What each tier is worth
base        = 0
start       = 5
step        = 5
tiers       = 10
format      = +{v}% sooner
