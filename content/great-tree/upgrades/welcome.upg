# ==================================================================
#  Welcome Wagon  (welcome)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Welcome Wagon
description = Extra XP orbs waiting at the start of every run, in every mode, like gifts from someone you will never meet.
part        = branch               # trunk, bough, branch or dream
growsFrom   = apple                # grows once this reaches the gate tier
position    = [214, 56]            # where it hangs on the tree picture
icon        = gift                 # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 1                    # tier 1
step        = 1                    # added every tier
tiers       = 20
format      = +{v} {v|orb|orbs}    # how a value is shown; {v} is the value
