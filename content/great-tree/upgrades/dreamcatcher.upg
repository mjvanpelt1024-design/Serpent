# ==================================================================
#  Dream Catcher  (dreamcatcher)
#  The Great Tree, dream
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Dream Catcher
description = A chance to shrug off a Nightmare twist that would end your run. Some dreams can be argued with.
part        = dream                # trunk, bough, branch or dream
requires    = nightmare            # all = every island; nightmare = the dream roots
position    = [120, 176]           # where it hangs on the tree picture
color       = #c07ad8
icon        = web                  # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 5                    # tier 1
step        = 5                    # added every tier
tiers       = 5
format      = {v}%                 # how a value is shown; {v} is the value
