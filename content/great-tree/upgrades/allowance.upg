# ==================================================================
#  Allowance  (allowance)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Allowance
description = Free XP for every full minute you survive in a run. At last, survival pays a wage.
part        = branch               # trunk, bough, branch or dream
growsFrom   = time                 # grows once this reaches the gate tier
position    = [26, 50]             # where it hangs on the tree picture
icon        = coins                # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 0.5                  # tier 1
step        = 0.5                  # added every tier
tiers       = 20
format      = +{v}% of a good run a minute
