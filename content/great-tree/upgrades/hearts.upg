# ==================================================================
#  Extra Hearts  (hearts)
#  The Great Tree, bough
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Extra Hearts
description = Hearts soak up popsicle, flea and fire damage, half a heart per upgrade. One can never have too many, I am told by people with several.
part        = bough                # trunk, bough, branch or dream
growsFrom   = xp                   # grows once this reaches the gate tier
position    = [120, 58]            # where it hangs on the tree picture
icon        = heart                # a picture in textures/icons/ (textures/index.json)
badge       = plus                 # corner mark: up, plus, x or star

# What each tier is worth
base        = 0                    # before the first tier
start       = 0.5                  # tier 1
step        = 0.5                  # added every tier
tiers       = 10
format      = hearts               # how a value is shown; {v} is the value
