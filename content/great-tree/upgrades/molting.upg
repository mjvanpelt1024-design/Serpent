# ==================================================================
#  Molting  (molting)
#  The Great Tree, branch (special, build 46)
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Molting
description = Shed Skin recharges faster, from the Hunting Grounds onward.
part        = branch               # trunk, bough, branch or dream
group       = special              # priced as a special part ([great] special in economy.txt)
growsFrom   = time                 # grows once this reaches the gate tier
position    = [36, 108]            # where it hangs on the tree picture
icon        = tail                 # a picture from src/engine/render/pixel-icons.js
badge       = plus

# What each tier is worth
base        = 0
start       = 3
step        = 3
tiers       = 10
format      = {v}% faster
