# ==================================================================
#  Parting Gift  (parting)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Parting Gift
description = When a run ends, a bonus on top of the XP you earned in it. A small consolation, which is the only kind I can offer.
part        = branch               # trunk, bough, branch or dream
growsFrom   = time                 # grows once this reaches the gate tier
position    = [22, 80]             # where it hangs on the tree picture
icon        = bag                  # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 2.5                  # tier 1
step        = 2.5                  # added every tier
tiers       = 20
format      = +{v}% of run XP      # how a value is shown; {v} is the value
