# ==================================================================
#  Big Appetite  (bigappetite)
#  The Great Tree, branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Big Appetite
description = Big apples (5x points) can show up in every mode, not just Treasure. Appetite has a way of spreading.
part        = branch               # trunk, bough, branch or dream
growsFrom   = apple                # grows once this reaches the gate tier
requires    = all                  # all = every island; nightmare = the dream roots
position    = [184, 32]            # where it hangs on the tree picture
icon        = apple                # a picture from src/engine/render/pixel-icons.js
badge       = star                 # corner mark: up, plus, x or star

# What each tier is worth
base        = 0                    # before the first tier
start       = 1                    # tier 1
step        = 1                    # added every tier
tiers       = 20
format      = {v}%                 # how a value is shown; {v} is the value
