# ==================================================================
#  The Coil
#  A Labyrinth-style maze, written out once from the old seeded generator
#  so it no longer changes between runs. Format: docs/CONTENT-FORMATS.md (Levels).
#  Below the ---: the board, one row per line, 80 squares a row.
#    .  open     #  red wall     P  portal wall     S  snake start
# ==================================================================

name    = The Coil
world   = labyrinth
level   = 3
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
# A portal wall (P in the board) lets you through to its exit; a red one (#) can be turned into one.
[portals]
p01 = "4-6,75 > 4-6,74"
p02 = "8-10,67 > 8-10,66"
p03 = "11,48-50 > 12,48-50"
p04 = "19,12-14 > 20,12-14"
p05 = "27,20-22 > 28,20-22"
p06 = "32-34,71 > 32-34,72"
p07 = "40-42,11 > 40-42,12"
p08 = "39,32-34 > 40,32-34"
p09 = "44-46,55 > 44-46,54"
p10 = "44-46,63 > 44-46,64"
p11 = "48-50,11 > 48-50,12"
p12 = "47,72-74 > 48,72-74"
p13 = "55,4-6 > 54,4-6"
p14 = "55,28-30 > 54,28-30"
p15 = "51,64-66 > 52,64-66"
p16 = "56-58,19 > 56-58,18"
p17 = "55,36-38 > 56,36-38"
p18 = "56-58,79 > 56-58,78"
p19 = "59,60-62 > 60,60-62"
p20 = "67,36-38 > 66,36-38"
p21 = "71,44-46 > 72,44-46"
p22 = "79,56-58 > 78,56-58"
---
