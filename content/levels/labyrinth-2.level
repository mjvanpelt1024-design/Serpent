# ==================================================================
#  Catacombs
#  A Labyrinth-style maze, written out once from the old seeded generator
#  so it no longer changes between runs. Format: docs/CONTENT-FORMATS.md (Levels).
#  Below the ---: the board, one row per line, 80 squares a row.
#    .  open     #  red wall     P  portal wall     S  snake start
# ==================================================================

name    = Catacombs
world   = labyrinth
level   = 2
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
# A portal wall (P in the board) lets you through to its exit; a red one (#) can be turned into one.
[portals]
p01 = "79,12-14 > 0,12-14"
p02 = "0-2,39 > 0-2,40"
p03 = "0-2,75 > 0-2,74"
p04 = "7,64-66 > 6,64-66"
p05 = "8-10,31 > 8-10,30"
p06 = "8-10,59 > 8-10,58"
p07 = "15,44-46 > 14,44-46"
p08 = "15,4-6 > 16,4-6"
p09 = "15,16-18 > 16,16-18"
p10 = "23,36-38 > 24,36-38"
p11 = "44-46,27 > 44-46,28"
p12 = "43,36-38 > 44,36-38"
p13 = "52-54,43 > 52-54,42"
p14 = "55,60-62 > 54,60-62"
p15 = "56-58,47 > 56-58,48"
p16 = "56-58,79 > 56-58,78"
p17 = "63,32-34 > 62,32-34"
p18 = "59,40-42 > 60,40-42"
p19 = "64-66,3 > 64-66,2"
p20 = "64-66,59 > 64-66,58"
p21 = "71,8-10 > 70,8-10"
p22 = "71,20-22 > 70,20-22"
p23 = "68-70,63 > 68-70,62"
p24 = "76-78,55 > 76-78,54"
---
