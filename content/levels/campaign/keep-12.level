# ==================================================================
#  The Hedge Maze
#  A campaign level's board. Format: docs/CONTENT-FORMATS.md (Levels).
#  The island's file (content/campaign/islands/) still holds the goal, speed and spawns;
#  this file is the board: walls, portal walls and where the snake starts.
#    .  open   #  red wall   P  portal wall   S  snake start
#    1 2 3  pulse walls: 1 up first, 2 up second, 3 always up
# ==================================================================

name    = The Hedge Maze
island  = keep
level   = 12
layout  = maze
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
[portals]
p01 = "4-6,39 > 4-6,38"
p02 = "7,4-6 > 8,4-6"
p03 = "7,20-22 > 8,20-22"
p04 = "12-14,79 > 12-14,0"
p05 = "12-14,63 > 12-14,64"
p06 = "20-22,75 > 20-22,76"
p07 = "27,32-34 > 26,32-34"
p08 = "24-26,71 > 24-26,70"
p09 = "27,48-50 > 28,48-50"
p10 = "40-42,11 > 40-42,10"
p11 = "44-46,79 > 44-46,78"
p12 = "55,12-14 > 54,12-14"
p13 = "59,72-74 > 58,72-74"
p14 = "60-62,19 > 60-62,18"
p15 = "63,4-6 > 64,4-6"
p16 = "64-66,15 > 64-66,16"
p17 = "64-66,71 > 64-66,72"
p18 = "72-74,15 > 72-74,14"
p19 = "76-78,79 > 76-78,0"
---
