# ==================================================================
#  The Twisting Archive
#  A campaign level's board. Format: docs/CONTENT-FORMATS.md (Levels).
#  The island's file (content/campaign/islands/) still holds the goal, speed and spawns;
#  this file is the board: walls, portal walls and where the snake starts.
#    .  open   #  red wall   P  portal wall   S  snake start
#    1 2 3  pulse walls: 1 up first, 2 up second, 3 always up
# ==================================================================

name    = The Twisting Archive
island  = spire
level   = 12
layout  = maze
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
[portals]
p01 = "4-6,7 > 4-6,8"
p02 = "4-6,75 > 4-6,76"
p03 = "8-10,43 > 8-10,44"
p04 = "15,32-34 > 14,32-34"
p05 = "16-18,51 > 16-18,50"
p06 = "19,60-62 > 18,60-62"
p07 = "28-30,39 > 28-30,40"
p08 = "31,12-14 > 32,12-14"
p09 = "32-34,67 > 32-34,66"
p10 = "40-42,51 > 40-42,50"
p11 = "39,68-70 > 40,68-70"
p12 = "44-46,27 > 44-46,26"
p13 = "52-54,67 > 52-54,68"
p14 = "56-58,35 > 56-58,34"
p15 = "71,8-10 > 70,8-10"
p16 = "75,36-38 > 74,36-38"
p17 = "72-74,51 > 72-74,52"
---
