# ==================================================================
#  Caldera Maze
#  A Labyrinth-style maze, written out once from the old seeded generator
#  so it no longer changes between runs. Format: docs/CONTENT-FORMATS.md (Levels).
#  Below the ---: the board, one row per line, 80 squares a row.
#    .  open     #  red wall     P  portal wall     S  snake start
# ==================================================================

name    = Caldera Maze
world   = crown
level   = 12
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
# A portal wall (P in the board) lets you through to its exit; a red one (#) can be turned into one.
[portals]
p01 = "8-10,3 > 8-10,4"
p02 = "27,64-66 > 28,64-66"
p03 = "32-34,7 > 32-34,8"
p04 = "32-34,23 > 32-34,24"
p05 = "44-46,75 > 44-46,76"
p06 = "51,40-42 > 50,40-42"
p07 = "48-50,59 > 48-50,60"
p08 = "52-54,75 > 52-54,74"
p09 = "59,20-22 > 58,20-22"
p10 = "60-62,7 > 60-62,6"
p11 = "63,12-14 > 64,12-14"
p12 = "67,56-58 > 66,56-58"
p13 = "64-66,63 > 64-66,64"
p14 = "71,4-6 > 72,4-6"
p15 = "72-74,55 > 72-74,54"
p16 = "72-74,71 > 72-74,70"
p17 = "76-78,23 > 76-78,22"
p18 = "79,64-66 > 78,64-66"
---
