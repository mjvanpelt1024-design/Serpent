# ==================================================================
#  Hedge of Thorns
#  A campaign level's board. Format: docs/CONTENT-FORMATS.md (Levels).
#  The island's file (content/campaign/islands/) still holds the goal, speed and spawns;
#  this file is the board: walls, portal walls and where the snake starts.
#    .  open   #  red wall   P  portal wall   S  snake start
#    1 2 3  pulse walls: 1 up first, 2 up second, 3 always up
# ==================================================================

name    = Hedge of Thorns
island  = hollow
level   = 12
layout  = maze
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
[portals]
p01 = "3,36-38 > 2,36-38"
p02 = "7,32-34 > 6,32-34"
p03 = "4-6,55 > 4-6,54"
p04 = "8-10,27 > 8-10,26"
p05 = "11,36-38 > 12,36-38"
p06 = "15,20-22 > 16,20-22"
p07 = "27,52-54 > 28,52-54"
p08 = "28-30,63 > 28-30,64"
p09 = "31,32-34 > 32,32-34"
p10 = "31,44-46 > 32,44-46"
p11 = "36-38,19 > 36-38,20"
p12 = "40-42,3 > 40-42,4"
p13 = "43,24-26 > 42,24-26"
p14 = "39,60-62 > 40,60-62"
p15 = "44-46,51 > 44-46,52"
p16 = "48-50,11 > 48-50,10"
p17 = "51,52-54 > 52,52-54"
p18 = "56-58,31 > 56-58,30"
p19 = "56-58,39 > 56-58,38"
p20 = "55,60-62 > 56,60-62"
p21 = "64-66,31 > 64-66,30"
p22 = "72-74,31 > 72-74,32"
p23 = "72-74,55 > 72-74,54"
