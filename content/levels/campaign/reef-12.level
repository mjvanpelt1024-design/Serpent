# ==================================================================
#  Sunken Maze
#  A campaign level's board. Format: docs/CONTENT-FORMATS.md (Levels).
#  The island's file (content/campaign/islands/) still holds the goal, speed and spawns;
#  this file is the board: walls, portal walls and where the snake starts.
#    .  open   #  red wall   P  portal wall   S  snake start
#    1 2 3  pulse walls: 1 up first, 2 up second, 3 always up
# ==================================================================

name    = Sunken Maze
island  = reef
level   = 12
layout  = maze
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
[portals]
p01 = "0-2,63 > 0-2,62"
p02 = "3,12-14 > 4,12-14"
p03 = "4-6,71 > 4-6,70"
p04 = "12-14,3 > 12-14,2"
p05 = "19,60-62 > 18,60-62"
p06 = "31,4-6 > 30,4-6"
p07 = "31,56-58 > 30,56-58"
p08 = "31,64-66 > 30,64-66"
p09 = "35,52-54 > 36,52-54"
p10 = "35,68-70 > 36,68-70"
p11 = "39,44-46 > 40,44-46"
p12 = "51,4-6 > 50,4-6"
p13 = "51,16-18 > 52,16-18"
p14 = "52-54,59 > 52-54,58"
p15 = "59,4-6 > 60,4-6"
p16 = "63,12-14 > 62,12-14"
p17 = "60-62,27 > 60-62,28"
p18 = "63,56-58 > 64,56-58"
p19 = "63,68-70 > 64,68-70"
p20 = "68-70,7 > 68-70,8"
p21 = "68-70,47 > 68-70,48"
p22 = "76-78,35 > 76-78,34"
p23 = "75,44-46 > 76,44-46"
p24 = "75,64-66 > 76,64-66"
