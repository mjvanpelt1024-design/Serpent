# ==================================================================
#  Hedgerow
#  A Labyrinth-style maze, written out once from the old seeded generator
#  so it no longer changes between runs. Format: docs/CONTENT-FORMATS.md (Levels).
#  Below the ---: the board, one row per line, 80 squares a row.
#    .  open     #  red wall     P  portal wall     S  snake start
# ==================================================================

name    = Hedgerow
world   = labyrinth
level   = 1
size    = 80
edge    = maze
span    = 4                       # squares per maze cell

# Dead-end portals: the wall squares, then the squares they lead to (straight lines).
# A portal wall (P in the board) lets you through to its exit; a red one (#) can be turned into one.
[portals]
p01 = "3,20-22 > 4,20-22"
p02 = "8-10,55 > 8-10,54"
p03 = "8-10,59 > 8-10,60"
p04 = "15,40-42 > 14,40-42"
p05 = "15,48-50 > 16,48-50"
p06 = "16-18,59 > 16-18,58"
p07 = "19,28-30 > 20,28-30"
p08 = "20-22,63 > 20-22,64"
p09 = "32-34,11 > 32-34,12"
p10 = "39,72-74 > 38,72-74"
p11 = "44-46,11 > 44-46,12"
p12 = "44-46,71 > 44-46,70"
p13 = "59,72-74 > 60,72-74"
p14 = "67,48-50 > 66,48-50"
p15 = "75,4-6 > 74,4-6"
p16 = "72-74,15 > 72-74,14"
p17 = "76-78,11 > 76-78,12"
p18 = "76-78,27 > 76-78,26"
p19 = "76-78,63 > 76-78,62"
---
