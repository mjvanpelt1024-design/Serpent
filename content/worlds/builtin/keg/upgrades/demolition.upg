# ==================================================================
#  Demolition  (demolition)
#  Powder Keg, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Demolition
description = Points for every rock a bomb clears, as a share of an apple, everywhere.
slot        = right                  # trunk, left, right, crown or nightmare
color       = #7a5232
icon        = rock                   # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 20                     # tier 1
step        = 20                     # added every tier
tiers       = 10
format      = {v}% of an apple       # how a value is shown; {v} is the value
