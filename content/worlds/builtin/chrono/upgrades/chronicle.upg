# ==================================================================
#  Chronicle  (chronicle)
#  Chrono Rift, trunk
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Chronicle
description = More passive points in the Chrono Rift, for every second that is, was or will be.
slot        = trunk                  # trunk, left, right, crown or nightmare
color       = #9fe8ff
icon        = clock                  # a picture in textures/icons/ (textures/index.json)
effect      = passivePoints          # applePoints, passivePoints or orbChance on this island; otherwise game code reads the id

# What each tier is worth
base        = 1                      # before the first tier
start       = 1.05                   # tier 1
step        = 0.05                   # added every tier
tiers       = 10
format      = x                      # how a value is shown; {v} is the value
