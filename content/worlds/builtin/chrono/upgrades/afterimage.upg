# ==================================================================
#  Afterimage  (afterimage)
#  Chrono Rift, crown
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Afterimage
description = Points every second while an Echo is out, everywhere.
slot        = crown                  # trunk, left, right, crown or nightmare
color       = #9fe8ff
icon        = eye                    # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 10                     # tier 1
step        = 10                     # added every tier
tiers       = 10
format      = +{v} points a second   # how a value is shown; {v} is the value
