# ==================================================================
#  Compass Needle  (nm_labyrinth)
#  The Heart of the Maze tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Compass Needle
description = A chance a wild portal still lands on screen in Sticky Maze. Lost, but not too lost.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = pin                  # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 20                   # tier 1
step        = 20                   # added every tier
tiers       = 5
format      = {v}%                 # how a value is shown; {v} is the value
