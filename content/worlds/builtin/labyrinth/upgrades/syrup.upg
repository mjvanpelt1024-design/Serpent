# ==================================================================
#  Syrup Skipper  (syrup)
#  The Heart of the Maze tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Syrup Skipper
description = Molasses lets go of you sooner. Sticky situations, mercifully shortened.
slot        = right                # trunk, left, right, crown or nightmare
color       = #8a5526
icon        = bottle               # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 8                    # tier 1
step        = 8                    # added every tier
tiers       = 10
format      = {v}% shorter         # how a value is shown; {v} is the value
