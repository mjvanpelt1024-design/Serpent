# ==================================================================
#  Figure Skater  (skater)
#  Frostbite Fjord, crown
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Figure Skater
description = More passive points while you're sliding on ice, everywhere.
slot        = crown                  # trunk, left, right, crown or nightmare
color       = #e8f8ff
icon        = shoe                   # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                      # before the first tier
start       = 10                     # tier 1
step        = 10                     # added every tier
tiers       = 10
format      = +{v}% on ice           # how a value is shown; {v} is the value
