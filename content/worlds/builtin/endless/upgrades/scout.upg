# ==================================================================
#  Scout  (scout)
#  The Long Tunnel tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Scout
description = Fewer popsicles scroll in during Endless. Someone has gone ahead to warn you. Usually nobody does.
slot        = right                # trunk, left, right, crown or nightmare
icon        = binoc                # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 4                    # tier 1
step        = 4                    # added every tier
tiers       = 10
format      = {v}% fewer           # how a value is shown; {v} is the value
