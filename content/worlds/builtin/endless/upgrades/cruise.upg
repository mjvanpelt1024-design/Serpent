# ==================================================================
#  Cruise Control  (cruise)
#  The Long Tunnel tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Cruise Control
description = Endless speeds up more slowly. The tunnel is in no hurry, and neither, now, are you.
slot        = left                 # trunk, left, right, crown or nightmare
icon        = car                  # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 6                    # tier 1
step        = 6                    # added every tier
tiers       = 10
format      = {v}% slower ramp     # how a value is shown; {v} is the value
