# ==================================================================
#  Solid Footing  (nm_endless)
#  The Long Tunnel tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Solid Footing
description = Easier to win back ground when Crumbling. Firmer footing on a failing floor.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = boot                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 1                    # tier 1
step        = 1                    # added every tier
tiers       = 5
format      = +{v}% ground         # how a value is shown; {v} is the value
