# ==================================================================
#  Thick Hide  (thickhide)
#  Bramblewood, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Thick Hide
description = A chance a bramble does no damage. Scales, it turns out, are good for something.
slot        = left                   # trunk, left, right, crown or nightmare
color       = #3f7a2a
icon        = shield                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 5                      # tier 1
step        = 5                      # added every tier
tiers       = 10
format      = {v}%                   # how a value is shown; {v} is the value
