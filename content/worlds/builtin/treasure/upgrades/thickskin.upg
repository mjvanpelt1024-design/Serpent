# ==================================================================
#  Thick Skin  (thickskin)
#  The Vault tree, crown
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Thick Skin
description = A chance a mega pop costs only a heart instead of ending your run. I have never managed to grow a thick skin. I envy you.
slot        = crown                # trunk, left, right, crown or nightmare
icon        = shield               # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 10                   # tier 1
step        = 10                   # added every tier
tiers       = 10
format      = {v}%                 # how a value is shown; {v} is the value
