# ==================================================================
#  Midas Touch  (midas)
#  The Vault tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Midas Touch
description = Big apples are worth even more in Treasure. Be careful what you touch.
slot        = left                 # trunk, left, right, crown or nightmare
icon        = crown                # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 5                    # before the first tier
start       = 5.25                 # tier 1
step        = 0.25                 # added every tier
tiers       = 10
format      = x                    # how a value is shown; {v} is the value
