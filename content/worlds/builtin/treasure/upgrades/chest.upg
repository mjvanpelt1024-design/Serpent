# ==================================================================
#  Treasure Chest  (chest)
#  The Vault tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Treasure Chest
description = Big XP is worth more in Treasure. The vault rewards those who keep looking.
slot        = right                # trunk, left, right, crown or nightmare
color       = #ffcf4d
icon        = chest                # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 2                    # tier 1
step        = 2                    # added every tier
tiers       = 10
format      = +{v} XP              # how a value is shown; {v} is the value
