# ==================================================================
#  Gold Rush  (goldrush)
#  The Vault tree, trunk
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Gold Rush
description = Big apples show up more often in Treasure. Fortune favors the slightly reckless.
slot        = trunk                # trunk, left, right, crown or nightmare
icon        = goldbar              # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 12                   # before the first tier
start       = 14                   # tier 1
step        = 2                    # added every tier
tiers       = 10
format      = {v}%                 # how a value is shown; {v} is the value
