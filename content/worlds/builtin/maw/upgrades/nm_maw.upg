# ==================================================================
#  Grappling Hook  (nm_maw)
#  The Maw, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Grappling Hook
description = Sinkholes crack for longer again, everywhere. Mostly useful in the Pit.
slot        = nightmare              # trunk, left, right, crown or nightmare
icon        = pin                    # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 10                     # tier 1
step        = 10                     # added every tier
tiers       = 5
format      = +{v}%                  # how a value is shown; {v} is the value
