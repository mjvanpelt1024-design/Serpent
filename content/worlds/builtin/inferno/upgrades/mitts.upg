# ==================================================================
#  Oven Mitts  (mitts)
#  The Furnace tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Oven Mitts
description = A chance fire only speeds you up, with no score or heart damage. The quiet hero of every kitchen.
slot        = left                 # trunk, left, right, crown or nightmare
color       = #d9b27c
icon        = mitt                 # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 10                   # tier 1
step        = 10                   # added every tier
tiers       = 10
format      = {v}%                 # how a value is shown; {v} is the value
