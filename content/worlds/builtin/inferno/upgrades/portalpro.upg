# ==================================================================
#  Portal Pro  (portalpro)
#  The Furnace tree, crown
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Portal Pro
description = Points every time you hop through a portal in Inferno. The purple doors appreciate the business.
slot        = crown                # trunk, left, right, crown or nightmare
color       = #8f4dff
icon        = portal               # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 50                   # tier 1
step        = 50                   # added every tier
tiers       = 10
format      = +{v} points          # how a value is shown; {v} is the value
