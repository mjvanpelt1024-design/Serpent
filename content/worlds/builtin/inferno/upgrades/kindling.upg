# ==================================================================
#  Kindling  (kindling)
#  The Furnace tree, trunk
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Kindling
description = Extra points while fire has you speeding. If one must burn, one may as well be paid for it.
slot        = trunk                # trunk, left, right, crown or nightmare
color       = #ffb020
icon        = logs                 # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 10                   # tier 1
step        = 10                   # added every tier
tiers       = 10
format      = +{v}% while fast     # how a value is shown; {v} is the value
