# ==================================================================
#  Quick Melt  (melt)
#  The Glass Hall tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Quick Melt
description = Popsicles melt away sooner in Mirror. Everything sweet is temporary, which for once is good news.
slot        = left                 # trunk, left, right, crown or nightmare
icon        = melt                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 4                    # tier 1
step        = 4                    # added every tier
tiers       = 10
format      = {v}% sooner          # how a value is shown; {v} is the value
