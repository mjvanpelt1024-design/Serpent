# ==================================================================
#  Antidote  (antidote)
#  The Glass Hall tree, trunk
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Antidote
description = A chance a poisonous popsicle does nothing, in any mode. Carry it always. Trust no dessert.
slot        = trunk                # trunk, left, right, crown or nightmare
icon        = potion               # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 3                    # tier 1
step        = 3                    # added every tier
tiers       = 10
format      = {v}%                 # how a value is shown; {v} is the value
