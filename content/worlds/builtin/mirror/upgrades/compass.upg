# ==================================================================
#  Compass  (compass)
#  The Glass Hall tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Compass
description = It always points somewhere familiar. A chance a Mirror edge sends you out the opposite side, the way edges ought to.
slot        = right                # trunk, left, right, crown or nightmare
icon        = compass              # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 5                    # tier 1
step        = 5                    # added every tier
tiers       = 10
format      = {v}%                 # how a value is shown; {v} is the value
