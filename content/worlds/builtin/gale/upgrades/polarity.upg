# ==================================================================
#  Polarity  (polarity)
#  Gale Cliffs, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Polarity
description = The Lodestone pulls for longer, everywhere.
slot        = right                  # trunk, left, right, crown or nightmare
color       = #8aaaba
icon        = magnet                 # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                      # before the first tier
start       = 10                     # tier 1
step        = 10                     # added every tier
tiers       = 10
format      = +{v}%                  # how a value is shown; {v} is the value
