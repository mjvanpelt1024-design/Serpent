# ==================================================================
#  Petal Rain  (petals)
#  Sunflower Fields, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Petal Rain
description = XP orbs turn up more often in Sunflower Fields. The flowers shed them like petals.
slot        = right                  # trunk, left, right, crown or nightmare
color       = #f0c030
icon        = flower                 # a picture in textures/icons/ (textures/index.json)
effect      = orbChance              # applePoints, passivePoints or orbChance on this island; otherwise game code reads the id

# What each tier is worth
base        = 0                      # before the first tier
start       = 5                      # tier 1
step        = 5                      # added every tier
tiers       = 10
format      = +{v}% orbs             # how a value is shown; {v} is the value
