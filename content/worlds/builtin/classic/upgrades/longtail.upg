# ==================================================================
#  Long Tail  (longtail)
#  The Old Yard tree, trunk
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Long Tail
description = Passive points grow with your length in Classic. The longer the tale, the larger the reward, which is not true of books.
slot        = trunk                # trunk, left, right, crown or nightmare
color       = #3ddc3d
icon        = tail                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 0.5                  # tier 1
step        = 0.5                  # added every tier
tiers       = 10
format      = +{v}% per 10 long    # how a value is shown; {v} is the value
