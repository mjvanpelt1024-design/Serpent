# ==================================================================
#  Night Light  (nightlight)
#  The Old Yard tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Night Light
description = See further in the dark during Blackout. A small light, which is often all anyone gets.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = lamp                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 1                    # tier 1
step        = 1                    # added every tier
tiers       = 5
format      = +{v} {v|square|squares}  # how a value is shown; {v} is the value
