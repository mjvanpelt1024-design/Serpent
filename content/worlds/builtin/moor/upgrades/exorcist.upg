# ==================================================================
#  Exorcist  (exorcist)
#  Haunted Moor, crown
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Exorcist
description = A chance that eating an apple banishes the ghosts near you, everywhere.
slot        = crown                  # trunk, left, right, crown or nightmare
color       = #6a7a6a
icon        = cross                  # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 5                      # tier 1
step        = 5                      # added every tier
tiers       = 10
format      = {v}%                   # how a value is shown; {v} is the value
