# ==================================================================
#  Lantern  (lantern)
#  Haunted Moor, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Lantern
description = Ghosts drift more slowly, everywhere. They don't care for the light.
slot        = left                   # trunk, left, right, crown or nightmare
color       = #3a4a3a
icon        = lamp                   # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                      # before the first tier
start       = 5                      # tier 1
step        = 5                      # added every tier
tiers       = 10
format      = {v}% slower            # how a value is shown; {v} is the value
