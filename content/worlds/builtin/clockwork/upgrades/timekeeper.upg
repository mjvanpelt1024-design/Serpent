# ==================================================================
#  Timekeeper  (timekeeper)
#  Clockwork Citadel, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Timekeeper
description = A chance raised spikes don't hurt you, everywhere.
slot        = left                   # trunk, left, right, crown or nightmare
color       = #b08a4a
icon        = clock                  # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 3                      # tier 1
step        = 3                      # added every tier
tiers       = 10
format      = {v}%                   # how a value is shown; {v} is the value
