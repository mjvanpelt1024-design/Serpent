# ==================================================================
#  Less Popsicles  (luck)
#  The Ice Parlor tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Less Popsicles
description = A chance each popsicle spawns as a bonus apple instead. Now and then a misfortune turns out to be lunch.
slot        = right                # trunk, left, right, crown or nightmare
icon        = clover               # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
values      = [6, 10, 13, 17, 21, 26, 31, 36, 42, 50]  # one per tier
format      = {v}%                 # how a value is shown; {v} is the value
