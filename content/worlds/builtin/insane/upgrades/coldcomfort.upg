# ==================================================================
#  Cold Comfort  (coldcomfort)
#  The Ice Parlor tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Cold Comfort
description = Every popsicle hit you survive in Insane pays out points. Misfortune, at last, with a receipt.
slot        = left                 # trunk, left, right, crown or nightmare
color       = #bfeaff
icon        = snowflake            # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 50                   # tier 1
step        = 50                   # added every tier
tiers       = 10
format      = +{v} points a hit    # how a value is shown; {v} is the value
