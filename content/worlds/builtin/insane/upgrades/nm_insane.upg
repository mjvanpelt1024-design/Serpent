# ==================================================================
#  Mercy Rule  (nm_insane)
#  The Ice Parlor tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Mercy Rule
description = A chance to survive a popsicle in No Mercy. A little mercy, smuggled in.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = whiteflag            # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 4                    # tier 1
step        = 4                    # added every tier
tiers       = 5
format      = {v}%                 # how a value is shown; {v} is the value
