# ==================================================================
#  Brake Pedal  (brake)
#  The Orchard Storm tree, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Brake Pedal
description = Takes the edge off Chaos speed. It stays the fastest place, but what flickers gets a little easier to catch.
slot        = right                # trunk, left, right, crown or nightmare
icon        = stop                 # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 1.2                  # tier 1
step        = 1.2                  # added every tier
tiers       = 10
format      = {v}% slower          # how a value is shown; {v} is the value
