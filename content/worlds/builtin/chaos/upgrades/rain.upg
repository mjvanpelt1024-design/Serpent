# ==================================================================
#  Apple Rain  (rain)
#  The Orchard Storm tree, left branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Apple Rain
description = More apples on the board in Chaos, as if there were not enough already.
slot        = left                 # trunk, left, right, crown or nightmare
icon        = cloud                # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 10                   # before the first tier
start       = 12                   # tier 1
step        = 2                    # added every tier
tiers       = 10
format      = {v} apples           # how a value is shown; {v} is the value
