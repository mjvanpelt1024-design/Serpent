# ==================================================================
#  Sugar Crash  (nm_chaos)
#  The Orchard Storm tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Sugar Crash
description = Each apple speeds you up less in Sugar High. A gentler crash, eventually.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = lollipop             # a picture from src/engine/render/pixel-icons.js

# What each tier is worth
base        = 0                    # before the first tier
start       = 10                   # tier 1
step        = 10                   # added every tier
tiers       = 5
format      = {v}% less            # how a value is shown; {v} is the value
