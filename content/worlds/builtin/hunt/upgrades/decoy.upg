# ==================================================================
#  Decoy  (decoy)
#  Hunting Grounds, right branch
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Decoy
description = A chance the Hunter goes after an apple instead of you, everywhere.
slot        = right                  # trunk, left, right, crown or nightmare
color       = #5a7a30
icon        = apple                  # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                      # before the first tier
start       = 3                      # tier 1
step        = 3                      # added every tier
tiers       = 10
format      = {v}%                   # how a value is shown; {v} is the value
