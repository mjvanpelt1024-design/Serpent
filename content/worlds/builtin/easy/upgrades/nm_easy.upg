# ==================================================================
#  Slow Metabolism  (nm_easy)
#  The Garden tree, Nightmare (red) upgrade
#  Prices come from content/economy.txt. To fix them by hand instead,
#  add: prices = [10, 20, 30, ...]  (one per tier)
# ==================================================================

name        = Slow Metabolism
description = Starving shrinks you less often. Hunger, held at arm's length.
slot        = nightmare            # trunk, left, right, crown or nightmare
icon        = fork                 # a picture in textures/icons/ (textures/index.json)

# What each tier is worth
base        = 0                    # before the first tier
start       = 0.5                  # tier 1
step        = 0.5                  # added every tier
tiers       = 5
format      = +{v}s between shrinks  # how a value is shown; {v} is the value
