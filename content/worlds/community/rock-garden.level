# Community level: Rock Garden
# The board is 20 x 20 below the ---. Key in docs/CONTENT-FORMATS.md (Levels).
name          = Rock Garden
edge          = mirror               # wrap, walls or mirror
speed         = 7                    # 5 slow, 7 normal, 10 fast
hearts        = 2
respawnApples = true                 # eaten apples come back
twists        = []                   # starve, dark, avalanche, noMercy, sugar, flip
spawns        = [flea]               # popsicle, flea, fire, molasses
panelsV       = []                   # wall panels on vertical grid lines, x/y:r (red) or x/y:p (portal)
panelsH       = []                   # same, on horizontal grid lines
