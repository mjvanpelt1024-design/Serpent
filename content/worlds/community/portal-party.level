# Community level: Portal Party
# The board is 20 x 20 below the ---. Key in docs/CONTENT-FORMATS.md (Levels).
name          = Portal Party
edge          = wrap                 # wrap, walls or mirror
speed         = 7                    # 5 slow, 7 normal, 10 fast
hearts        = 3
respawnApples = true                 # eaten apples come back
twists        = []                   # starve, dark, avalanche, noMercy, sugar, flip
spawns        = []                   # popsicle, flea, fire, molasses
panelsV       = [7/4:p, 13/4:r, 7/5:r, 13/5:r, 7/6:r, 13/6:p, 7/7:r, 13/7:r, 7/8:p, 13/8:r, 7/9:r, 13/9:r, 7/11:r, 13/11:r, 7/12:p, 13/12:r, 7/13:r, 13/13:r, 7/14:r, 13/14:p, 7/15:r, 13/15:r]  # wall panels on vertical grid lines, x/y:r (red) or x/y:p (portal)
panelsH       = []                   # same, on horizontal grid lines
